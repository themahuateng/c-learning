#include <stdio.h>

/* TODO 1：补全第一个参数，让它能接收一个“每行 3 个 int”的二维数组 */
void print_matrix(int a[][3], int rows)
{
    for (int i = 0; i < rows; i++)
    {
        for (int j = 0; j < 3; j++)
        {
            printf("%d ", a[i][j]);
        }
        printf("\n");
    }
}

